# Safe single-node deployment configuration. This file contains no credentials.
AI_MAP_DATA_DIR=.data/single-node
AI_MAP_HOST=127.0.0.1
AI_MAP_PORT=8000
AI_MAP_SECURE_COOKIE=true
AI_MAP_LOG_LEVEL=info
# Shared graceful-drain / ASGI teardown bound in seconds (1-3600).
AI_MAP_SHUTDOWN_TIMEOUT_SECONDS=30
# Optional versioned local catalog mapping release gate names to deterministic/#86/#19 evidence.
# AI_MAP_APPLICATION_RELEASE_GATE_POLICY=config/application-release-gates.json

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoresymphony.github.io/ai-multi-agent-platform/schemas/inference-backend-evaluation-report.v1.schema.json",
  "title": "AI Multi-Agent Platform Inference Backend Evaluation Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "campaign_id",
    "backend",
    "backend_revision",
    "platform_commit",
    "started_at",
    "completed_at",
    "model",
    "environment",
    "workload",
    "metrics",
    "contract_results",
    "failure_results",
    "placement",
    "raw_evidence",
    "comparability",
    "decision_eligible"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_id": {"type": "string", "minLength": 1},
    "backend": {"enum": ["sglang", "vllm", "llama.cpp", "ollama"]},
    "backend_revision": {"type": "string", "minLength": 1},
    "platform_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "model": {
      "type": "object",
      "required": ["model_id", "model_revision", "quantization_or_dtype"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "model_revision": {"type": "string", "minLength": 1},
        "quantization_or_dtype": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "backend_image_or_package",
        "launch_command",
        "os_kernel",
        "python_version",
        "accelerator_runtime",
        "driver_version",
        "gpu_model",
        "gpu_count",
        "gpu_vram_bytes",
        "cpu_model",
        "host_ram_bytes",
        "worker_ids",
        "network_topology",
        "authentication_exposure",
        "cache_state"
      ],
      "properties": {
        "backend_image_or_package": {"type": "string", "minLength": 1},
        "launch_command": {"type": "string", "minLength": 1},
        "os_kernel": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1},
        "accelerator_runtime": {"type": "string", "minLength": 1},
        "driver_version": {"type": "string", "minLength": 1},
        "gpu_model": {"type": "string", "minLength": 1},
        "gpu_count": {"type": "integer", "minimum": 0},
        "gpu_vram_bytes": {"type": "integer", "minimum": 0},
        "cpu_model": {"type": "string", "minLength": 1},
        "host_ram_bytes": {"type": "integer", "minimum": 1},
        "worker_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "network_topology": {"type": "string", "minLength": 1},
        "authentication_exposure": {"type": "string", "minLength": 1},
        "cache_state": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "workload": {
      "type": "object",
      "required": [
        "scenario_id",
        "request_count",
        "warmup_policy",
        "input_length_policy",
        "output_length_policy",
        "request_rate",
        "concurrency"
      ],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "request_count": {"type": "integer", "minimum": 1},
        "warmup_policy": {"type": "string", "minLength": 1},
        "input_length_policy": {"type": "string", "minLength": 1},
        "output_length_policy": {"type": "string", "minLength": 1},
        "request_rate": {
          "oneOf": [
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "null"}
          ]
        },
        "concurrency": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "cold_load_seconds",
        "ready_to_first_request_seconds",
        "request_throughput_per_second",
        "input_token_throughput_per_second",
        "output_token_throughput_per_second",
        "total_token_throughput_per_second",
        "end_to_end_latency_p50_ms",
        "end_to_end_latency_p95_ms",
        "end_to_end_latency_p99_ms",
        "ttft_p50_ms",
        "ttft_p95_ms",
        "ttft_p99_ms",
        "itl_or_tpot_p50_ms",
        "itl_or_tpot_p95_ms",
        "itl_or_tpot_p99_ms",
        "peak_vram_bytes",
        "steady_vram_bytes",
        "peak_host_ram_bytes",
        "steady_host_ram_bytes",
        "error_count"
      ],
      "properties": {
        "cold_load_seconds": {"type": ["number", "null"], "minimum": 0},
        "ready_to_first_request_seconds": {"type": ["number", "null"], "minimum": 0},
        "request_throughput_per_second": {"type": ["number", "null"], "minimum": 0},
        "input_token_throughput_per_second": {"type": ["number", "null"], "minimum": 0},
        "output_token_throughput_per_second": {"type": ["number", "null"], "minimum": 0},
        "total_token_throughput_per_second": {"type": ["number", "null"], "minimum": 0},
        "end_to_end_latency_p50_ms": {"type": ["number", "null"], "minimum": 0},
        "end_to_end_latency_p95_ms": {"type": ["number", "null"], "minimum": 0},
        "end_to_end_latency_p99_ms": {"type": ["number", "null"], "minimum": 0},
        "ttft_p50_ms": {"type": ["number", "null"], "minimum": 0},
        "ttft_p95_ms": {"type": ["number", "null"], "minimum": 0},
        "ttft_p99_ms": {"type": ["number", "null"], "minimum": 0},
        "itl_or_tpot_p50_ms": {"type": ["number", "null"], "minimum": 0},
        "itl_or_tpot_p95_ms": {"type": ["number", "null"], "minimum": 0},
        "itl_or_tpot_p99_ms": {"type": ["number", "null"], "minimum": 0},
        "peak_vram_bytes": {"type": ["integer", "null"], "minimum": 0},
        "steady_vram_bytes": {"type": ["integer", "null"], "minimum": 0},
        "peak_host_ram_bytes": {"type": ["integer", "null"], "minimum": 0},
        "steady_host_ram_bytes": {"type": ["integer", "null"], "minimum": 0},
        "error_count": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "contract_results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceResult"}
    },
    "failure_results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceResult"}
    },
    "placement": {
      "type": "object",
      "required": ["case_id", "status", "worker_count", "gpu_count"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "not_measured"]},
        "worker_count": {"type": "integer", "minimum": 1},
        "gpu_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "raw_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceFile"}
    },
    "comparability": {
      "type": "object",
      "required": ["comparable", "reasons"],
      "properties": {
        "comparable": {"type": "boolean"},
        "reasons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "decision_eligible": {"type": "boolean"}
  },
  "$defs": {
    "evidenceResult": {
      "type": "object",
      "required": ["case_id", "status", "evidence_refs"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "not_measured"]},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "evidenceFile": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

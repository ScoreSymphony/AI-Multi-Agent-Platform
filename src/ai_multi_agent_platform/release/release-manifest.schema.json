{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoresymphony.github.io/ai-multi-agent-platform/schemas/release-manifest-v2.json",
  "title": "AI Multi-Agent Platform release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_version",
    "release_kind",
    "source_commit",
    "created_at",
    "release_notes_ref",
    "versions",
    "dependency_sets",
    "upstreams",
    "compatibility",
    "gates",
    "artifact_hashes",
    "sbom_ref",
    "provenance_ref"
  ],
  "properties": {
    "schema_version": {"const": "2"},
    "release_version": {"type": "string", "minLength": 1},
    "release_kind": {
      "enum": ["patch", "minor", "major", "security_hotfix", "prerelease"]
    },
    "source_commit": {"$ref": "#/$defs/gitCommit"},
    "created_at": {"type": "string", "format": "date-time"},
    "release_notes_ref": {"$ref": "#/$defs/reference"},
    "versions": {"$ref": "#/$defs/versionSnapshot"},
    "dependency_sets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dependencySet"}
    },
    "upstreams": {
      "type": "array",
      "items": {"$ref": "#/$defs/upstream"}
    },
    "compatibility": {
      "type": "array",
      "items": {"$ref": "#/$defs/compatibility"}
    },
    "gates": {
      "type": "array",
      "items": {"$ref": "#/$defs/gate"}
    },
    "artifact_hashes": {"$ref": "#/$defs/artifactHashMap"},
    "sbom_ref": {"$ref": "#/$defs/reference"},
    "provenance_ref": {"$ref": "#/$defs/reference"}
  },
  "$defs": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "digest": {
      "type": "string",
      "pattern": "^(?:sha256:[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
    },
    "reference": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:.+$"
    },
    "digestMap": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/digest"}
    },
    "artifactHashMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/digest"}
    },
    "versionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_release", "domain_schema", "api", "migration_revision",
        "plugin_manifest", "portable_format", "template_schema", "backup_format",
        "worker_protocol", "message_protocol", "adapter_versions",
        "plugin_interface_versions"
      ],
      "properties": {
        "platform_release": {"type": "string", "minLength": 1},
        "domain_schema": {"type": "string", "minLength": 1},
        "api": {"type": "string", "minLength": 1},
        "migration_revision": {"type": "string", "minLength": 1},
        "plugin_manifest": {"type": "string", "minLength": 1},
        "portable_format": {"type": "string", "minLength": 1},
        "template_schema": {"type": "string", "minLength": 1},
        "backup_format": {"type": "string", "minLength": 1},
        "worker_protocol": {"type": "string", "minLength": 1},
        "message_protocol": {"type": "string", "minLength": 1},
        "adapter_versions": {"$ref": "#/$defs/stringMap"},
        "plugin_interface_versions": {"$ref": "#/$defs/stringMap"}
      }
    },
    "dependencySet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ecosystem", "kind", "source_ref", "digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "ecosystem": {"type": "string", "minLength": 1},
        "kind": {"enum": ["lockfile", "resolved_set"]},
        "source_ref": {"$ref": "#/$defs/reference"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component", "source_url", "revision", "revision_kind", "license", "modified",
        "patches", "build_status", "test_status", "artifact_hashes", "sbom_ref",
        "provenance_ref", "last_verified_at"
      ],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "minLength": 1},
        "revision_kind": {"enum": ["commit", "tag", "version", "digest"]},
        "license": {"type": "string", "minLength": 1},
        "modified": {"type": "boolean"},
        "patches": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "build_status": {"type": "string", "minLength": 1},
        "test_status": {"type": "string", "minLength": 1},
        "artifact_hashes": {"$ref": "#/$defs/digestMap"},
        "sbom_ref": {"anyOf": [{"$ref": "#/$defs/reference"}, {"type": "null"}]},
        "provenance_ref": {"anyOf": [{"$ref": "#/$defs/reference"}, {"type": "null"}]},
        "last_verified_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"revision_kind": {"const": "commit"}}},
          "then": {"properties": {"revision": {"$ref": "#/$defs/gitCommit"}}}
        },
        {
          "if": {"properties": {"revision_kind": {"const": "digest"}}},
          "then": {"properties": {"revision": {"$ref": "#/$defs/digest"}}}
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component", "upstream_revision", "status", "tested_at",
        "platform_constraint", "notes"
      ],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "upstream_revision": {"type": "string", "minLength": 1},
        "status": {
          "enum": ["supported", "tested", "experimental", "deprecated", "blocked"]
        },
        "tested_at": {"type": "string", "format": "date-time"},
        "platform_constraint": {"type": "string", "minLength": 1},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "source_commit", "digest"],
      "properties": {
        "kind": {
          "enum": ["workflow_run", "report", "artifact", "review", "drill", "attestation"]
        },
        "ref": {"$ref": "#/$defs/reference"},
        "source_commit": {"anyOf": [{"$ref": "#/$defs/gitCommit"}, {"type": "null"}]},
        "digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "evidence", "required"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed", "not_run"]},
        "evidence": {"$ref": "#/$defs/evidence"},
        "required": {"type": "boolean"}
      }
    }
  }
}

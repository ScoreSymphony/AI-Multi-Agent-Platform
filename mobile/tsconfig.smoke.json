{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "outDir": ".smoke-dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "src/client.ts",
    "src/session.ts",
    "src/types.ts"
  ]
}

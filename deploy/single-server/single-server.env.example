# Reference single-server deployment configuration for issue #39.
# This file contains no credentials. Keep any real deployment copy outside the repository
# and readable only by the service account/administrators that need it.

AI_MAP_DATA_DIR=/var/lib/ai-multi-agent-platform
AI_MAP_HOST=127.0.0.1
AI_MAP_PORT=8000
AI_MAP_SECURE_COOKIE=true
AI_MAP_LOG_LEVEL=info

{
    admin off
    auto_https off
}

:80 {
    header {
        Content-Type "text/plain; charset=utf-8"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }

    respond "AI Multi-Agent Platform setup pending. The default Hostinger hostname could not be derived safely. Set AI_MAP_PUBLIC_DOMAIN to a DNS hostname that points to this VPS and redeploy. Application traffic remains blocked." 503
}

{
    admin off
    auto_https off
}

:8080 {
    encode zstd gzip

    handle /api/* {
        reverse_proxy control-plane:8000
    }

    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
}

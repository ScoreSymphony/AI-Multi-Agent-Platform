{
    admin off
    auto_https off
}

:8080 {
    header {
        Content-Type "text/plain; charset=utf-8"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }

    respond "AI Multi-Agent Platform setup pending. Set AI_MAP_PUBLIC_DOMAIN in the Hostinger Docker project environment, point DNS at this VPS, and redeploy. Application traffic is blocked until a valid public hostname is configured." 503
}

# Issue #562 non-secret Host B wiring example.
PLATFORM_DISTRIBUTED_PROFILE=deploy/distributed/profiles/remote-worker.json
ISSUE562_CONTROL_PLANE_PRIVATE_URL=https://10.203.0.1:8443
PLATFORM_MESSAGE_BROKER_HOST=10.203.0.1
PLATFORM_MESSAGE_BROKER_PORT=8765

# The canonical Worker credential and transport authentication material must be
# injected at runtime and never stored in this file:
# PLATFORM_WORKER_TOKEN=<runtime secret; never commit>
# PLATFORM_TRANSPORT_AUTH_KEY=<runtime secret; never commit>
# client certificate and key paths=<operator-managed runtime files>

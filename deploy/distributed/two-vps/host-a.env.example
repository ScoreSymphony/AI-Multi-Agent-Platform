# Issue #562 non-secret Host A wiring example.
# Secret-bearing TLS/HMAC values are intentionally not included.
PLATFORM_DISTRIBUTED_PROFILE=deploy/distributed/profiles/remote-worker.json
PLATFORM_MESSAGE_BROKER_HOST=10.203.0.1
PLATFORM_MESSAGE_BROKER_PORT=8765

# The Worker protocol must be exposed through the deployment's HTTPS edge on the
# private tunnel address only. Public client ingress, if enabled, is a separate edge.
ISSUE562_WORKER_PROTOCOL_PRIVATE_HOST=10.203.0.1
ISSUE562_WORKER_PROTOCOL_PRIVATE_PORT=8443

# Runtime-only secret material belongs in operator-managed files/environment:
# PLATFORM_TRANSPORT_AUTH_KEY=<runtime secret; never commit>
# broker/client certificate and key paths=<operator-managed runtime files>

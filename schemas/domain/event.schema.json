{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Canonical Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "event_type", "occurred_at", "subject_type", "subject_id", "correlation_id", "payload"],
  "properties": {
    "id": {"type": "string", "pattern": "^event_[0-9a-fA-F-]{36}$"},
    "schema_version": {"type": "string", "const": "1.0"},
    "event_type": {"type": "string", "minLength": 1},
    "occurred_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "subject_type": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string", "null"]},
    "payload": {"type": "object", "additionalProperties": true},
    "external_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/externalRef"}}
  }
}

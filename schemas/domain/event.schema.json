{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Canonical Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "event_type", "occurred_at", "subject_type", "subject_id", "correlation_id", "payload"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/eventId"},
    "schema_version": {"type": "string", "const": "1.0"},
    "event_type": {"type": "string", "minLength": 1},
    "occurred_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "subject_type": {
      "type": "string",
      "enum": [
        "goal",
        "project",
        "task",
        "plan",
        "step",
        "run",
        "agent",
        "agent_team",
        "artifact",
        "result",
        "event",
        "approval",
        "node",
        "worker",
        "worker_job",
        "tool",
        "capability",
        "model_assignment"
      ]
    },
    "subject_id": {"type": "string"},
    "owner_ref": {"anyOf": [{"$ref": "common.schema.json#/$defs/ownerRef"}, {"type": "null"}]},
    "project_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/projectId"}, {"type": "null"}]},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string", "null"]},
    "trace_id": {"type": ["string", "null"]},
    "payload": {"type": "object", "additionalProperties": true},
    "provenance": {"anyOf": [{"$ref": "common.schema.json#/$defs/provenance"}, {"type": "null"}]},
    "external_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/externalRef"}}
  },
  "allOf": [
    {"if": {"properties": {"subject_type": {"const": "goal"}}, "required": ["subject_type"]}, "then": {"properties": {"subject_id": {"$ref": "common.schema.json#/$defs/goalId"}}}},
    {"if": {"properties": {"subject_type": {"const": "project"}}, "required": ["subject_type"]}, "then": {"properties": {"subject_id": {"$ref": "common.schema.json#/$defs/projectId"}}}},
    {"if": {"properties": {"subject_type": {"const": "task"}}, "required": ["subject_type"]}, "then": {"properties": {"subject_id": {"$ref": "common.schema.json#/$defs/taskId"}}}},
    {"if": {"properties": {"subject_type": {"const": "plan"}}, "required": ["subject_type"]}, "then": {"properties": {"subject_id": {"$ref": "common.schema.json#/$defs/planId"}}}},
    {"if": {"properties": {"subject_type": {"const": "step"}}, "required": ["subject_type"]}, "then": {"properties": {"subject_id": {"$ref": "common.schema.json#/$defs/stepId"}}}},
    {"if": {"properties": {"subject_type": {"const": "run"}}, "required": ["subject_type"]}, "then": {"properties": {"subject_id": {"$ref": "common.schema.json#/$defs/runId"}}}},
    {"if": {"properties": {"subject_type": {"const": "agent"}}, "required": ["subject_type"]}, "then": {"properties": {"subject_id": {"$ref": "common.schema.json#/$defs/agentId"}}}},
    {"if": {"properties": {"subject_type": {"const": "agent_team"}}, "required": ["subject_type"]}, "then": {"properties": {"subject_id": {"$ref": "common.schema.json#/$defs/teamId"}}}},
    {"if": {"properties": {"subject_type": {"const": "artifact"}}, "required": ["subject_type"]}, "then": {"properties": {"subject_id": {"$ref": "common.schema.json#/$defs/artifactId"}}}},
    {"if": {"properties": {"subject_type": {"const": "result"}}, "required": ["subject_type"]}, "then": {"properties": {"subject_id": {"$ref": "common.schema.json#/$defs/resultId"}}}},
    {"if": {"properties": {"subject_type": {"const": "event"}}, "required": ["subject_type"]}, "then": {"properties": {"subject_id": {"$ref": "common.schema.json#/$defs/eventId"}}}},
    {"if": {"properties": {"subject_type": {"const": "approval"}}, "required": ["subject_type"]}, "then": {"properties": {"subject_id": {"$ref": "common.schema.json#/$defs/approvalId"}}}},
    {"if": {"properties": {"subject_type": {"const": "node"}}, "required": ["subject_type"]}, "then": {"properties": {"subject_id": {"$ref": "common.schema.json#/$defs/nodeId"}}}},
    {"if": {"properties": {"subject_type": {"const": "worker"}}, "required": ["subject_type"]}, "then": {"properties": {"subject_id": {"$ref": "common.schema.json#/$defs/workerId"}}}},
    {"if": {"properties": {"subject_type": {"const": "worker_job"}}, "required": ["subject_type"]}, "then": {"properties": {"subject_id": {"$ref": "common.schema.json#/$defs/workerJobId"}}}},
    {"if": {"properties": {"subject_type": {"const": "tool"}}, "required": ["subject_type"]}, "then": {"properties": {"subject_id": {"$ref": "common.schema.json#/$defs/toolId"}}}},
    {"if": {"properties": {"subject_type": {"const": "capability"}}, "required": ["subject_type"]}, "then": {"properties": {"subject_id": {"$ref": "common.schema.json#/$defs/capabilityId"}}}},
    {"if": {"properties": {"subject_type": {"const": "model_assignment"}}, "required": ["subject_type"]}, "then": {"properties": {"subject_id": {"$ref": "common.schema.json#/$defs/modelAssignmentId"}}}}
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "Canonical Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "status", "created_at", "updated_at", "owner_ref", "title"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/taskId"},
    "schema_version": {"type": "string", "const": "1.0"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "status": {"type": "string", "enum": ["draft", "ready", "running", "waiting", "succeeded", "failed", "cancelled"]},
    "goal_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/goalId"}, {"type": "null"}]},
    "project_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/projectId"}, {"type": "null"}]},
    "owner_ref": {"$ref": "common.schema.json#/$defs/ownerRef"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "correlation_id": {"type": ["string", "null"]},
    "causation_id": {"type": ["string", "null"]},
    "labels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "provenance": {"anyOf": [{"$ref": "common.schema.json#/$defs/provenance"}, {"type": "null"}]},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "external_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/externalRef"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoresymphony.github.io/ai-multi-agent-platform/schemas/domain/task.schema.json",
  "title": "Canonical Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "status", "created_at", "updated_at", "owner_ref", "title"],
  "properties": {
    "id": {"type": "string", "pattern": "^task_[0-9a-fA-F-]{36}$"},
    "schema_version": {"type": "string", "const": "1.0"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "status": {
      "type": "string",
      "enum": ["draft", "ready", "running", "succeeded", "failed", "cancelled"]
    },
    "goal_id": {"type": ["string", "null"], "pattern": "^goal_[0-9a-fA-F-]{36}$"},
    "project_id": {"type": ["string", "null"], "pattern": "^project_[0-9a-fA-F-]{36}$"},
    "owner_ref": {"$ref": "common.schema.json#/$defs/ownerRef"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "correlation_id": {"type": ["string", "null"]},
    "labels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "external_refs": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/externalRef"}
    }
  }
}

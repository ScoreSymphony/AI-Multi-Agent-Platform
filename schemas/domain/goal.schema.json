{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "goal.schema.json",
  "title": "Canonical Durable Goal Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal_id",
    "title",
    "objective",
    "owner_ref",
    "created_at",
    "updated_at",
    "revision",
    "digest",
    "status",
    "progress",
    "success_criteria",
    "constraints",
    "observation_policy",
    "task_generation_policy",
    "autonomy_policy",
    "linked_tasks",
    "evidence",
    "reviews",
    "consecutive_failed_cycles"
  ],
  "properties": {
    "goal_id": {"$ref": "common.schema.json#/$defs/goalId"},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "owner_ref": {"$ref": "common.schema.json#/$defs/ownerRef"},
    "project_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/projectId"}, {"type": "null"}]},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "revision": {"type": "integer", "minimum": 1},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {
      "type": "string",
      "enum": ["draft", "active", "waiting", "paused", "satisfied", "failed", "cancelled", "superseded"]
    },
    "progress": {
      "type": "string",
      "enum": ["unknown", "monitoring", "active_work", "blocked", "partial", "satisfied", "degraded"]
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/successCriterion"}
    },
    "constraints": {"$ref": "#/$defs/constraints"},
    "observation_policy": {"$ref": "#/$defs/observationPolicy"},
    "task_generation_policy": {"$ref": "#/$defs/taskGenerationPolicy"},
    "autonomy_policy": {"$ref": "#/$defs/autonomyPolicy"},
    "deadline": {"anyOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
    "linked_tasks": {"type": "array", "items": {"$ref": "#/$defs/taskLink"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "reviews": {"type": "array", "items": {"$ref": "#/$defs/review"}},
    "consecutive_failed_cycles": {"type": "integer", "minimum": 0},
    "next_review_at": {"anyOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
    "terminal_reason": {"type": ["string", "null"]},
    "created_actor_ref": {"type": ["string", "null"]},
    "updated_actor_ref": {"type": ["string", "null"]}
  },
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "successCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "kind", "description", "operator", "target", "required"],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["human_acceptance", "metric", "canonical_state", "verified_assertion", "linked_tasks"]},
        "description": {"type": "string", "minLength": 1},
        "operator": {"type": "string", "enum": ["eq", "gte", "lte", "gt", "lt", "truthy"]},
        "target": {},
        "required": {"type": "boolean"}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "out_of_scope", "risk_requirements", "data_requirements", "security_requirements"],
      "properties": {
        "requirements": {"$ref": "#/$defs/stringArray"},
        "out_of_scope": {"$ref": "#/$defs/stringArray"},
        "risk_requirements": {"$ref": "#/$defs/stringArray"},
        "data_requirements": {"$ref": "#/$defs/stringArray"},
        "security_requirements": {"$ref": "#/$defs/stringArray"}
      }
    },
    "observationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automation_id", "review_interval_seconds", "event_types"],
      "properties": {
        "automation_id": {"type": ["string", "null"]},
        "review_interval_seconds": {"type": ["integer", "null"], "minimum": 1},
        "event_types": {"$ref": "#/$defs/stringArray"}
      }
    },
    "taskGenerationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "task_title", "proposal_required"],
      "properties": {
        "enabled": {"type": "boolean"},
        "task_title": {"type": ["string", "null"]},
        "proposal_required": {"type": "boolean"}
      }
    },
    "autonomyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tasks_per_review", "max_consecutive_failed_cycles", "human_checkpoint_required"],
      "properties": {
        "max_tasks_per_review": {"type": "integer", "minimum": 0},
        "max_consecutive_failed_cycles": {"type": "integer", "minimum": 1},
        "human_checkpoint_required": {"type": "boolean"}
      }
    },
    "taskLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "goal_revision", "review_id", "task_state", "valid_for_current_revision", "created_at"],
      "properties": {
        "task_id": {"$ref": "common.schema.json#/$defs/taskId"},
        "goal_revision": {"type": "integer", "minimum": 1},
        "review_id": {"type": ["string", "null"]},
        "task_state": {"type": "string", "enum": ["active", "succeeded", "failed", "cancelled", "superseded"]},
        "valid_for_current_revision": {"type": "boolean"},
        "created_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "criterion_id", "kind", "value", "source_ref", "verified", "actor_ref", "observed_at"],
      "properties": {
        "evidence_id": {"$ref": "common.schema.json#/$defs/eventId"},
        "criterion_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "value": {},
        "source_ref": {"type": "string", "minLength": 1},
        "verified": {"type": "boolean"},
        "actor_ref": {"type": ["string", "null"]},
        "observed_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "criterionEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "state", "evidence_ids", "reason"],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1},
        "state": {"type": "string", "enum": ["unknown", "unsatisfied", "satisfied"]},
        "evidence_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/eventId"}},
        "reason": {"type": "string"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "goal_revision", "trigger_ref", "criterion_evaluations", "generated_task_ids", "work_required", "decision_reason", "reviewed_at"],
      "properties": {
        "review_id": {"type": "string", "minLength": 1},
        "goal_revision": {"type": "integer", "minimum": 1},
        "trigger_ref": {"type": "string", "minLength": 1},
        "criterion_evaluations": {"type": "array", "items": {"$ref": "#/$defs/criterionEvaluation"}},
        "generated_task_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/taskId"}},
        "work_required": {"type": "boolean"},
        "decision_reason": {"type": "string"},
        "reviewed_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    }
  }
}

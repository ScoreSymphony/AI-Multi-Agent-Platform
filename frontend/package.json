{
  "name": "@ai-multi-agent-platform/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=11.6.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "generate:contracts": "python ../scripts/generate_frontend_contracts.py",
    "check:contracts": "python ../scripts/generate_frontend_contracts.py --check",
    "test": "npm run check:contracts && node scripts/check-transport-boundary.mjs && vitest run",
    "check:transport": "node scripts/check-transport-boundary.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}

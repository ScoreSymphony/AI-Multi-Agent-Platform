{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoresymphony.github.io/ai-multi-agent-platform/schemas/benchmark-reference-host-campaign.v1.schema.json",
  "title": "AI Multi-Agent Platform Reference Host Campaign v1",
  "type": "object",
  "required": [
    "schema_version",
    "campaign_id",
    "campaign_version",
    "profile",
    "host_label",
    "platform_version",
    "platform_commit",
    "started_at",
    "completed_at",
    "duration_seconds",
    "work_dir_mode",
    "configuration",
    "configuration_sha256",
    "environment",
    "environment_fingerprint_sha256",
    "sweep_summary",
    "soak_report",
    "operating_envelope",
    "claim_semantics",
    "budget_status",
    "correctness_passed"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_id": {"const": "single-node.reference.host-campaign"},
    "campaign_version": {"const": "1.0"},
    "profile": {"enum": ["release", "smoke"]},
    "host_label": {"type": "string", "minLength": 1},
    "platform_version": {"type": "string", "minLength": 1},
    "platform_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "work_dir_mode": {"enum": ["explicit", "temporary"]},
    "configuration": {
      "type": "object",
      "required": [
        "name",
        "concurrency_levels",
        "operations_per_level",
        "sweep_repetitions",
        "warmup_operations",
        "timeout_seconds",
        "soak_duration_seconds",
        "soak_sample_interval_seconds",
        "soak_max_operations",
        "soak_concurrency",
        "soak_seed_tasks",
        "soak_warmup_operations",
        "soak_read_weight",
        "soak_write_weight"
      ],
      "properties": {
        "name": {"enum": ["release", "smoke"]},
        "concurrency_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "operations_per_level": {"type": "integer", "minimum": 1},
        "sweep_repetitions": {"type": "integer", "minimum": 1},
        "warmup_operations": {"type": "integer", "minimum": 0},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "soak_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "soak_sample_interval_seconds": {"type": "number", "exclusiveMinimum": 0},
        "soak_max_operations": {"type": "integer", "minimum": 1},
        "soak_concurrency": {"type": "integer", "minimum": 1},
        "soak_seed_tasks": {"type": "integer", "minimum": 1},
        "soak_warmup_operations": {"type": "integer", "minimum": 0},
        "soak_read_weight": {"type": "integer", "minimum": 0},
        "soak_write_weight": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment": {"type": "object"},
    "environment_fingerprint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sweep_summary": {"$ref": "#/$defs/evidenceFile"},
    "soak_report": {"$ref": "#/$defs/evidenceFile"},
    "operating_envelope": {"$ref": "#/$defs/evidenceFile"},
    "claim_semantics": {"const": "single-host-tested-evidence-only"},
    "budget_status": {"const": "not-established"},
    "correctness_passed": {"const": true}
  },
  "$defs": {
    "evidenceFile": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"profile": {"const": "release"}},
        "required": ["profile"]
      },
      "then": {
        "properties": {
          "work_dir_mode": {"const": "explicit"},
          "configuration": {
            "properties": {
              "name": {"const": "release"},
              "concurrency_levels": {"const": [1, 10, 50, 100]},
              "operations_per_level": {"const": 500},
              "sweep_repetitions": {"const": 5},
              "warmup_operations": {"const": 20},
              "timeout_seconds": {"const": 60.0},
              "soak_duration_seconds": {"const": 3600.0},
              "soak_sample_interval_seconds": {"const": 10.0},
              "soak_max_operations": {"const": 20000},
              "soak_concurrency": {"const": 10},
              "soak_seed_tasks": {"const": 100},
              "soak_warmup_operations": {"const": 20},
              "soak_read_weight": {"const": 4},
              "soak_write_weight": {"const": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"profile": {"const": "smoke"}},
        "required": ["profile"]
      },
      "then": {
        "properties": {
          "configuration": {
            "properties": {"name": {"const": "smoke"}}
          }
        }
      }
    }
  ],
  "additionalProperties": false
}

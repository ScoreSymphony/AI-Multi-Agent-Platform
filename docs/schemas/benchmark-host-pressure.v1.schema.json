{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoresymphony.github.io/ai-multi-agent-platform/schemas/benchmark-host-pressure.v1.schema.json",
  "title": "AI Multi-Agent Platform Host Pressure Semantic Benchmark Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark",
    "platform_version",
    "platform_commit",
    "started_at",
    "duration_seconds",
    "environment",
    "phase_latency",
    "phase_action_counts",
    "phase_pressure_state_counts",
    "phase_reason_counts",
    "phase_scheduler_acceptance_counts",
    "resources",
    "safety",
    "correctness",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark": {
      "type": "object",
      "required": [
        "benchmark_id",
        "benchmark_version",
        "iterations_per_phase",
        "safety_max_iterations_per_phase",
        "workload_class",
        "expected_invariants",
        "captured_metrics"
      ],
      "properties": {
        "benchmark_id": {"type": "string", "minLength": 1},
        "benchmark_version": {"type": "string", "minLength": 1},
        "iterations_per_phase": {"type": "integer", "minimum": 1},
        "safety_max_iterations_per_phase": {"type": "integer", "minimum": 1},
        "workload_class": {"const": "heavy"},
        "expected_invariants": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "captured_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "platform_version": {"type": "string"},
    "platform_commit": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "environment": {"type": "object"},
    "phase_latency": {"$ref": "#/$defs/phaseLatencies"},
    "phase_action_counts": {"$ref": "#/$defs/phaseCounts"},
    "phase_pressure_state_counts": {"$ref": "#/$defs/phaseCounts"},
    "phase_reason_counts": {"$ref": "#/$defs/phaseCounts"},
    "phase_scheduler_acceptance_counts": {"$ref": "#/$defs/phaseCounts"},
    "resources": {
      "type": "object",
      "required": [
        "process_cpu_seconds",
        "traced_memory_current_bytes",
        "traced_memory_peak_bytes",
        "peak_rss_bytes",
        "open_file_descriptors"
      ],
      "properties": {
        "process_cpu_seconds": {"type": "number", "minimum": 0},
        "traced_memory_current_bytes": {"type": "integer", "minimum": 0},
        "traced_memory_peak_bytes": {"type": "integer", "minimum": 0},
        "peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
        "open_file_descriptors": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": [
        "synthetic_fixture",
        "host_mutation_attempted",
        "destructive_load_generated",
        "iterations_per_phase",
        "safety_max_iterations_per_phase"
      ],
      "properties": {
        "synthetic_fixture": {"const": true},
        "host_mutation_attempted": {"const": false},
        "destructive_load_generated": {"const": false},
        "iterations_per_phase": {"type": "integer", "minimum": 1},
        "safety_max_iterations_per_phase": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "correctness": {
      "type": "object",
      "required": [
        "attempted_decisions",
        "matching_decisions",
        "unexpected_decisions",
        "scheduler_acceptance_mismatches",
        "active_reservations_after",
        "recovered",
        "passed"
      ],
      "properties": {
        "attempted_decisions": {"type": "integer", "minimum": 0},
        "matching_decisions": {"type": "integer", "minimum": 0},
        "unexpected_decisions": {"type": "integer", "minimum": 0},
        "scheduler_acceptance_mismatches": {"type": "integer", "minimum": 0},
        "active_reservations_after": {"type": "integer", "minimum": 0},
        "recovered": {"type": "boolean"},
        "passed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "latency": {
      "type": "object",
      "required": ["count", "min_ms", "mean_ms", "p50_ms", "p95_ms", "p99_ms", "max_ms"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "min_ms": {"type": "number", "minimum": 0},
        "mean_ms": {"type": "number", "minimum": 0},
        "p50_ms": {"type": "number", "minimum": 0},
        "p95_ms": {"type": "number", "minimum": 0},
        "p99_ms": {"type": "number", "minimum": 0},
        "max_ms": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "phaseLatencies": {
      "type": "object",
      "required": ["healthy", "elevated", "critical", "recovery"],
      "properties": {
        "healthy": {"$ref": "#/$defs/latency"},
        "elevated": {"$ref": "#/$defs/latency"},
        "critical": {"$ref": "#/$defs/latency"},
        "recovery": {"$ref": "#/$defs/latency"}
      },
      "additionalProperties": false
    },
    "phaseCounts": {
      "type": "object",
      "required": ["healthy", "elevated", "critical", "recovery"],
      "properties": {
        "healthy": {"$ref": "#/$defs/countMap"},
        "elevated": {"$ref": "#/$defs/countMap"},
        "critical": {"$ref": "#/$defs/countMap"},
        "recovery": {"$ref": "#/$defs/countMap"}
      },
      "additionalProperties": false
    },
    "countMap": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  },
  "additionalProperties": false
}

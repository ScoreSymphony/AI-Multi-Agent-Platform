{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoresymphony.github.io/ai-multi-agent-platform/schemas/benchmark-provider-fault.v1.schema.json",
  "title": "AI Multi-Agent Platform Provider Fault Benchmark Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark",
    "platform_version",
    "platform_commit",
    "started_at",
    "duration_seconds",
    "environment",
    "expected_fault_error_code",
    "phase_throughput_operations_per_second",
    "phase_latency",
    "provider_service_latency",
    "platform_overhead_latency",
    "resources",
    "correctness",
    "error_counts",
    "retryable_error_counts",
    "measurements",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark": {
      "type": "object",
      "required": [
        "benchmark_id",
        "benchmark_version",
        "scenario",
        "operations_per_phase",
        "concurrency",
        "fault_delay_seconds",
        "tool_timeout_seconds",
        "cancel_after_seconds",
        "operation_timeout_seconds",
        "safety_max_operations_per_phase",
        "safety_max_concurrency",
        "expected_invariants",
        "captured_metrics"
      ],
      "properties": {
        "benchmark_id": {"type": "string", "minLength": 1},
        "benchmark_version": {"type": "string", "minLength": 1},
        "scenario": {
          "enum": [
            "model-latency",
            "model-unavailable",
            "model-cancelled",
            "tool-unavailable",
            "tool-timeout",
            "tool-cancelled"
          ]
        },
        "operations_per_phase": {"type": "integer", "minimum": 1},
        "concurrency": {"type": "integer", "minimum": 1},
        "fault_delay_seconds": {"type": "number", "exclusiveMinimum": 0},
        "tool_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "cancel_after_seconds": {"type": "number", "exclusiveMinimum": 0},
        "operation_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "safety_max_operations_per_phase": {"type": "integer", "minimum": 1},
        "safety_max_concurrency": {"type": "integer", "minimum": 1},
        "expected_invariants": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "captured_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "platform_version": {"type": "string"},
    "platform_commit": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "environment": {"type": "object"},
    "expected_fault_error_code": {"type": ["string", "null"]},
    "phase_throughput_operations_per_second": {"$ref": "#/$defs/phaseNumbers"},
    "phase_latency": {"$ref": "#/$defs/phaseLatencies"},
    "provider_service_latency": {"$ref": "#/$defs/phaseLatencies"},
    "platform_overhead_latency": {"$ref": "#/$defs/phaseLatencies"},
    "resources": {"$ref": "#/$defs/resources"},
    "correctness": {
      "type": "object",
      "required": [
        "attempted_operations",
        "successful_operations",
        "expected_failures",
        "unexpected_failures",
        "retryable_failures",
        "baseline_successes",
        "fault_successes",
        "recovery_successes",
        "provider_cancelled_calls",
        "automatic_retry_attempts",
        "recovered",
        "passed"
      ],
      "properties": {
        "attempted_operations": {"type": "integer", "minimum": 0},
        "successful_operations": {"type": "integer", "minimum": 0},
        "expected_failures": {"type": "integer", "minimum": 0},
        "unexpected_failures": {"type": "integer", "minimum": 0},
        "retryable_failures": {"type": "integer", "minimum": 0},
        "baseline_successes": {"type": "integer", "minimum": 0},
        "fault_successes": {"type": "integer", "minimum": 0},
        "recovery_successes": {"type": "integer", "minimum": 0},
        "provider_cancelled_calls": {"type": "integer", "minimum": 0},
        "automatic_retry_attempts": {"type": "integer", "minimum": 0},
        "recovered": {"type": "boolean"},
        "passed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "error_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "retryable_error_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "measurements": {
      "type": "object",
      "additionalProperties": {"type": ["integer", "number", "string", "boolean", "null"]}
    },
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "latency": {
      "type": "object",
      "required": ["count", "min_ms", "mean_ms", "p50_ms", "p95_ms", "p99_ms", "max_ms"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "min_ms": {"type": "number", "minimum": 0},
        "mean_ms": {"type": "number", "minimum": 0},
        "p50_ms": {"type": "number", "minimum": 0},
        "p95_ms": {"type": "number", "minimum": 0},
        "p99_ms": {"type": "number", "minimum": 0},
        "max_ms": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "phaseLatencies": {
      "type": "object",
      "required": ["baseline", "fault", "recovery"],
      "properties": {
        "baseline": {"$ref": "#/$defs/latency"},
        "fault": {"$ref": "#/$defs/latency"},
        "recovery": {"$ref": "#/$defs/latency"}
      },
      "additionalProperties": false
    },
    "phaseNumbers": {
      "type": "object",
      "required": ["baseline", "fault", "recovery"],
      "properties": {
        "baseline": {"type": "number", "minimum": 0},
        "fault": {"type": "number", "minimum": 0},
        "recovery": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": [
        "process_cpu_seconds",
        "traced_memory_current_bytes",
        "traced_memory_peak_bytes",
        "peak_rss_bytes",
        "open_file_descriptors"
      ],
      "properties": {
        "process_cpu_seconds": {"type": "number", "minimum": 0},
        "traced_memory_current_bytes": {"type": "integer", "minimum": 0},
        "traced_memory_peak_bytes": {"type": "integer", "minimum": 0},
        "peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
        "open_file_descriptors": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoresymphony.github.io/ai-multi-agent-platform/schemas/benchmark-stress.v1.schema.json",
  "title": "AI Multi-Agent Platform Stress Benchmark Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark",
    "platform_version",
    "platform_commit",
    "started_at",
    "environment",
    "points",
    "requested_levels",
    "completed_levels",
    "stop_reason",
    "first_failed_concurrency",
    "correctness_passed",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark": {
      "type": "object",
      "required": [
        "benchmark_id",
        "benchmark_version",
        "deployment_profile",
        "persistence_profile",
        "concurrency_levels",
        "operations_per_level",
        "warmup_operations",
        "timeout_seconds",
        "safety_max_concurrency",
        "safety_max_operations_per_level",
        "stop_on_correctness_failure",
        "optional_subsystems",
        "expected_invariants",
        "captured_metrics"
      ],
      "properties": {
        "benchmark_id": {"type": "string", "minLength": 1},
        "benchmark_version": {"type": "string", "minLength": 1},
        "deployment_profile": {"const": "single-node-reference"},
        "persistence_profile": {"type": "string", "minLength": 1},
        "concurrency_levels": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1},
          "uniqueItems": true
        },
        "operations_per_level": {"type": "integer", "minimum": 1},
        "warmup_operations": {"type": "integer", "minimum": 0},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "safety_max_concurrency": {"type": "integer", "minimum": 1},
        "safety_max_operations_per_level": {"type": "integer", "minimum": 1},
        "stop_on_correctness_failure": {"type": "boolean"},
        "optional_subsystems": {"type": "array", "items": {"type": "string"}},
        "expected_invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "captured_metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "platform_version": {"type": "string"},
    "platform_commit": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "environment": {"type": "object"},
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "concurrency",
          "report_file",
          "duration_seconds",
          "throughput_operations_per_second",
          "p50_latency_ms",
          "p95_latency_ms",
          "p99_latency_ms",
          "attempted_operations",
          "completed_operations",
          "failed_operations",
          "error_rate",
          "traced_memory_peak_bytes",
          "peak_rss_bytes",
          "storage_growth_bytes",
          "correctness_passed"
        ],
        "properties": {
          "concurrency": {"type": "integer", "minimum": 1},
          "report_file": {"type": "string", "minLength": 1},
          "duration_seconds": {"type": "number", "minimum": 0},
          "throughput_operations_per_second": {"type": "number", "minimum": 0},
          "p50_latency_ms": {"type": "number", "minimum": 0},
          "p95_latency_ms": {"type": "number", "minimum": 0},
          "p99_latency_ms": {"type": "number", "minimum": 0},
          "attempted_operations": {"type": "integer", "minimum": 0},
          "completed_operations": {"type": "integer", "minimum": 0},
          "failed_operations": {"type": "integer", "minimum": 0},
          "error_rate": {"type": "number", "minimum": 0, "maximum": 1},
          "traced_memory_peak_bytes": {"type": "integer", "minimum": 0},
          "peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
          "storage_growth_bytes": {"type": "integer"},
          "correctness_passed": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "requested_levels": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
    "completed_levels": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
    "stop_reason": {"enum": ["completed-levels", "correctness-failure"]},
    "first_failed_concurrency": {"type": ["integer", "null"], "minimum": 1},
    "correctness_passed": {"type": "boolean"},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

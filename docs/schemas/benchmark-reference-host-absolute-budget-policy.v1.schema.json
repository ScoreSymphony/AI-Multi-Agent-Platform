{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoresymphony.github.io/ai-multi-agent-platform/schemas/benchmark-reference-host-absolute-budget-policy.v1.schema.json",
  "title": "AI Multi-Agent Platform Reference Host Absolute Budget Policy v1",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "justification",
    "evidence_refs",
    "minimum_campaign_count",
    "basis",
    "rules"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "justification": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "minimum_campaign_count": {"type": "integer", "minimum": 2},
    "basis": {
      "type": "object",
      "required": [
        "host_label",
        "profile",
        "configuration_sha256",
        "environment_fingerprint_sha256",
        "deployment_profile",
        "persistence_profile",
        "workload_distribution"
      ],
      "properties": {
        "host_label": {"type": "string", "minLength": 1},
        "profile": {"const": "release"},
        "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "environment_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "deployment_profile": {"type": "string", "minLength": 1},
        "persistence_profile": {"type": "string", "minLength": 1},
        "workload_distribution": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "scope",
          "metric",
          "concurrency",
          "direction",
          "minimum_metric_sample_count",
          "warning_boundary",
          "release_blocking_boundary",
          "evidence_refs"
        ],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "scope": {"enum": ["concurrency", "endurance"]},
          "metric": {
            "enum": [
              "throughput_operations_per_second",
              "p95_latency_ms",
              "storage_growth_bytes",
              "traced_memory_growth_bytes",
              "peak_rss_growth_bytes",
              "open_file_descriptor_growth",
              "latency_drift_ratio"
            ]
          },
          "concurrency": {"type": ["integer", "null"], "minimum": 1},
          "direction": {"enum": ["higher-is-better", "lower-is-better"]},
          "minimum_metric_sample_count": {"type": "integer", "minimum": 2},
          "warning_boundary": {"type": "number"},
          "release_blocking_boundary": {"type": "number"},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "allOf": [
          {
            "if": {"properties": {"scope": {"const": "concurrency"}}, "required": ["scope"]},
            "then": {
              "properties": {
                "concurrency": {"type": "integer", "minimum": 1},
                "metric": {
                  "enum": [
                    "throughput_operations_per_second",
                    "p95_latency_ms",
                    "storage_growth_bytes"
                  ]
                }
              }
            }
          },
          {
            "if": {"properties": {"scope": {"const": "endurance"}}, "required": ["scope"]},
            "then": {"properties": {"concurrency": {"const": null}}}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoresymphony.github.io/ai-multi-agent-platform/schemas/benchmark-reference-host-regression-report.v1.schema.json",
  "title": "AI Multi-Agent Platform Reference Host Regression Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_version",
    "generated_at",
    "claim_semantics",
    "platform_budget_status",
    "policy",
    "baseline",
    "candidate",
    "basis",
    "overall_classification",
    "rules",
    "correctness_passed"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark_id": {"const": "single-node.reference.host-campaign.regression"},
    "benchmark_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "claim_semantics": {"const": "comparable-release-regression-policy-only"},
    "platform_budget_status": {"const": "not-established"},
    "policy": {
      "type": "object",
      "required": [
        "source",
        "sha256",
        "policy_id",
        "policy_version",
        "justification",
        "evidence_refs",
        "minimum_campaign_count"
      ],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "policy_id": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "justification": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "minimum_campaign_count": {"type": "integer", "minimum": 2}
      },
      "additionalProperties": false
    },
    "baseline": {"$ref": "#/$defs/sourceEvidence"},
    "candidate": {"$ref": "#/$defs/sourceEvidence"},
    "basis": {
      "type": "object",
      "required": [
        "host_label",
        "profile",
        "configuration_sha256",
        "environment_fingerprint_sha256",
        "deployment_profile",
        "persistence_profile",
        "workload_distribution"
      ],
      "properties": {
        "host_label": {"type": "string", "minLength": 1},
        "profile": {"const": "release"},
        "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "environment_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "deployment_profile": {"type": "string", "minLength": 1},
        "persistence_profile": {"type": "string", "minLength": 1},
        "workload_distribution": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "overall_classification": {"enum": ["pass", "warning", "release-blocking"]},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "scope",
          "metric",
          "concurrency",
          "direction",
          "baseline_median",
          "candidate_median",
          "baseline_sample_count",
          "candidate_sample_count",
          "baseline_relative_range",
          "baseline_coefficient_of_variation",
          "relative_regression",
          "noise_tolerance_relative",
          "warning_relative_regression",
          "release_blocking_relative_regression",
          "classification",
          "evidence_refs"
        ],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "scope": {"enum": ["concurrency", "endurance"]},
          "metric": {"type": "string", "minLength": 1},
          "concurrency": {"type": ["integer", "null"], "minimum": 1},
          "direction": {"enum": ["higher-is-better", "lower-is-better"]},
          "baseline_median": {"type": "number"},
          "candidate_median": {"type": "number"},
          "baseline_sample_count": {"type": "integer", "minimum": 1},
          "candidate_sample_count": {"type": "integer", "minimum": 1},
          "baseline_relative_range": {"type": ["number", "null"], "minimum": 0},
          "baseline_coefficient_of_variation": {"type": ["number", "null"], "minimum": 0},
          "relative_regression": {"type": "number"},
          "noise_tolerance_relative": {"type": "number", "minimum": 0},
          "warning_relative_regression": {"type": "number", "minimum": 0},
          "release_blocking_relative_regression": {"type": "number", "minimum": 0},
          "classification": {
            "enum": ["improvement", "within-noise", "pass", "warning", "release-blocking"]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "correctness_passed": {"const": true}
  },
  "$defs": {
    "sourceEvidence": {
      "type": "object",
      "required": [
        "source",
        "sha256",
        "platform_version",
        "platform_commit",
        "campaign_count"
      ],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "platform_version": {"type": "string", "minLength": 1},
        "platform_commit": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
        "campaign_count": {"type": "integer", "minimum": 2}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

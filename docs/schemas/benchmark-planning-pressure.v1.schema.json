{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoresymphony.github.io/ai-multi-agent-platform/schemas/benchmark-planning-pressure.v1.schema.json",
  "title": "AI Multi-Agent Platform Planning Pressure Benchmark Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark",
    "platform_version",
    "platform_commit",
    "started_at",
    "duration_seconds",
    "environment",
    "throughput_lifecycles_per_second",
    "initial_proposal_latency",
    "initial_activation_latency",
    "replan_proposal_latency",
    "replan_activation_latency",
    "resources",
    "correctness",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark": {
      "type": "object",
      "required": [
        "operation_count",
        "concurrency",
        "steps_per_plan",
        "warmup_operations",
        "timeout_seconds",
        "safety_max_operations",
        "safety_max_concurrency",
        "safety_max_steps_per_plan",
        "benchmark_id",
        "benchmark_version",
        "deployment_profile",
        "persistence_profile",
        "planner_profile",
        "expected_invariants",
        "captured_metrics"
      ],
      "properties": {
        "operation_count": {"type": "integer", "minimum": 1},
        "concurrency": {"type": "integer", "minimum": 1},
        "steps_per_plan": {"type": "integer", "minimum": 1},
        "warmup_operations": {"type": "integer", "minimum": 0},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "safety_max_operations": {"type": "integer", "minimum": 1},
        "safety_max_concurrency": {"type": "integer", "minimum": 1},
        "safety_max_steps_per_plan": {"type": "integer", "minimum": 1},
        "benchmark_id": {"const": "single-node.planning-pressure"},
        "benchmark_version": {"const": "1.0"},
        "deployment_profile": {"const": "single-node-reference"},
        "persistence_profile": {"const": "sqlite-kernel+coordinator+json-planning"},
        "planner_profile": {"const": "deterministic-reference-no-model-provider"},
        "expected_invariants": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "captured_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "platform_version": {"type": "string"},
    "platform_commit": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "environment": {"type": "object"},
    "throughput_lifecycles_per_second": {"type": "number", "minimum": 0},
    "initial_proposal_latency": {"$ref": "#/$defs/latency"},
    "initial_activation_latency": {"$ref": "#/$defs/latency"},
    "replan_proposal_latency": {"$ref": "#/$defs/latency"},
    "replan_activation_latency": {"$ref": "#/$defs/latency"},
    "resources": {"$ref": "#/$defs/resources"},
    "correctness": {
      "type": "object",
      "required": [
        "requested_cycles",
        "completed_cycles",
        "initial_proposals_validated",
        "initial_plans_activated",
        "terminal_replans_validated",
        "replacement_plans_activated",
        "canonical_failure_evidence_resolved",
        "distinct_replacement_plans",
        "provider_invocations",
        "passed"
      ],
      "properties": {
        "requested_cycles": {"type": "integer", "minimum": 1},
        "completed_cycles": {"type": "integer", "minimum": 0},
        "initial_proposals_validated": {"type": "integer", "minimum": 0},
        "initial_plans_activated": {"type": "integer", "minimum": 0},
        "terminal_replans_validated": {"type": "integer", "minimum": 0},
        "replacement_plans_activated": {"type": "integer", "minimum": 0},
        "canonical_failure_evidence_resolved": {"type": "integer", "minimum": 0},
        "distinct_replacement_plans": {"type": "integer", "minimum": 0},
        "provider_invocations": {"const": 0},
        "passed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "latency": {
      "type": "object",
      "required": ["count", "min_ms", "mean_ms", "p50_ms", "p95_ms", "p99_ms", "max_ms"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "min_ms": {"type": "number", "minimum": 0},
        "mean_ms": {"type": "number", "minimum": 0},
        "p50_ms": {"type": "number", "minimum": 0},
        "p95_ms": {"type": "number", "minimum": 0},
        "p99_ms": {"type": "number", "minimum": 0},
        "max_ms": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": [
        "process_cpu_seconds",
        "traced_memory_current_bytes",
        "traced_memory_peak_bytes",
        "peak_rss_bytes",
        "storage_bytes_before",
        "storage_bytes_after",
        "storage_growth_bytes",
        "open_file_descriptors"
      ],
      "properties": {
        "process_cpu_seconds": {"type": "number", "minimum": 0},
        "traced_memory_current_bytes": {"type": "integer", "minimum": 0},
        "traced_memory_peak_bytes": {"type": "integer", "minimum": 0},
        "peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
        "storage_bytes_before": {"type": "integer", "minimum": 0},
        "storage_bytes_after": {"type": "integer", "minimum": 0},
        "storage_growth_bytes": {"type": "integer"},
        "open_file_descriptors": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

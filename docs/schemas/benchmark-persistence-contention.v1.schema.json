{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark-persistence-contention.v1.schema.json",
  "title": "SQLite Persistence Contention Benchmark Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark",
    "platform_version",
    "platform_commit",
    "started_at",
    "duration_seconds",
    "environment",
    "throughput_logical_operations_per_second",
    "operation_latency",
    "resources",
    "contention",
    "correctness",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writer_count",
        "tasks_per_writer",
        "barrier_timeout_seconds",
        "safety_max_writers",
        "safety_max_tasks_per_writer",
        "benchmark_id",
        "benchmark_version",
        "deployment_profile",
        "persistence_profile",
        "task_count",
        "logical_operation_count",
        "synchronized_rounds",
        "expected_invariants",
        "captured_metrics",
        "scope_limitations"
      ],
      "properties": {
        "writer_count": {"type": "integer", "minimum": 2},
        "tasks_per_writer": {"type": "integer", "minimum": 1},
        "barrier_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "safety_max_writers": {"type": "integer", "minimum": 2},
        "safety_max_tasks_per_writer": {"type": "integer", "minimum": 1},
        "benchmark_id": {"const": "persistence.sqlite.writer-contention"},
        "benchmark_version": {"const": "1.0"},
        "deployment_profile": {"const": "single-node-reference"},
        "persistence_profile": {"const": "sqlite-reference"},
        "task_count": {"type": "integer", "minimum": 2},
        "logical_operation_count": {"type": "integer", "minimum": 4},
        "synchronized_rounds": {"type": "integer", "minimum": 2},
        "expected_invariants": {"type": "array", "items": {"type": "string"}},
        "captured_metrics": {"type": "array", "items": {"type": "string"}},
        "scope_limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "platform_version": {"type": "string", "minLength": 1},
    "platform_commit": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "duration_seconds": {"type": "number", "minimum": 0},
    "environment": {"type": "object"},
    "throughput_logical_operations_per_second": {"type": "number", "minimum": 0},
    "operation_latency": {"$ref": "#/$defs/latency"},
    "resources": {"$ref": "#/$defs/resources"},
    "contention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writer_instances",
        "synchronized_rounds",
        "peak_in_flight_operations",
        "sqlite_busy_errors",
        "contract_conflicts",
        "unexpected_errors",
        "per_writer_successful_operations"
      ],
      "properties": {
        "writer_instances": {"type": "integer", "minimum": 2},
        "synchronized_rounds": {"type": "integer", "minimum": 2},
        "peak_in_flight_operations": {"type": "integer", "minimum": 0},
        "sqlite_busy_errors": {"type": "integer", "minimum": 0},
        "contract_conflicts": {"type": "integer", "minimum": 0},
        "unexpected_errors": {"type": "integer", "minimum": 0},
        "per_writer_successful_operations": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0},
          "minItems": 2
        }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_tasks",
        "completed_tasks",
        "expected_logical_operations",
        "successful_logical_operations",
        "failed_logical_operations",
        "task_state_failures",
        "history_failures",
        "command_record_failures",
        "stream_set_failures",
        "passed"
      ],
      "properties": {
        "expected_tasks": {"type": "integer", "minimum": 2},
        "completed_tasks": {"type": "integer", "minimum": 0},
        "expected_logical_operations": {"type": "integer", "minimum": 4},
        "successful_logical_operations": {"type": "integer", "minimum": 0},
        "failed_logical_operations": {"type": "integer", "minimum": 0},
        "task_state_failures": {"type": "integer", "minimum": 0},
        "history_failures": {"type": "integer", "minimum": 0},
        "command_record_failures": {"type": "integer", "minimum": 0},
        "stream_set_failures": {"type": "integer", "minimum": 0},
        "passed": {"type": "boolean"}
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "min_ms", "mean_ms", "p50_ms", "p95_ms", "p99_ms", "max_ms"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "min_ms": {"type": "number", "minimum": 0},
        "mean_ms": {"type": "number", "minimum": 0},
        "p50_ms": {"type": "number", "minimum": 0},
        "p95_ms": {"type": "number", "minimum": 0},
        "p99_ms": {"type": "number", "minimum": 0},
        "max_ms": {"type": "number", "minimum": 0}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_cpu_seconds",
        "traced_memory_current_bytes",
        "traced_memory_peak_bytes",
        "peak_rss_bytes",
        "storage_bytes_before",
        "storage_bytes_after",
        "storage_growth_bytes",
        "open_file_descriptors"
      ],
      "properties": {
        "process_cpu_seconds": {"type": "number", "minimum": 0},
        "traced_memory_current_bytes": {"type": "integer", "minimum": 0},
        "traced_memory_peak_bytes": {"type": "integer", "minimum": 0},
        "peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
        "storage_bytes_before": {"type": "integer", "minimum": 0},
        "storage_bytes_after": {"type": "integer", "minimum": 0},
        "storage_growth_bytes": {"type": "integer"},
        "open_file_descriptors": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoresymphony.github.io/ai-multi-agent-platform/schemas/benchmark-operating-envelope-catalog.v1.schema.json",
  "title": "AI Multi-Agent Platform Cross-Host Operating Envelope Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_version",
    "generated_at",
    "basis",
    "host_count",
    "distinct_environment_count",
    "union_concurrency_levels",
    "shared_concurrency_levels",
    "comparison_status",
    "cross_host_comparison_ready",
    "claim_semantics",
    "cross_host_aggregation",
    "budget_status",
    "hosts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark_id": {"const": "single-node.reference.operating-envelope.catalog"},
    "benchmark_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "basis": {"$ref": "#/$defs/basis"},
    "host_count": {"type": "integer", "minimum": 1},
    "distinct_environment_count": {"type": "integer", "minimum": 1},
    "union_concurrency_levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "shared_concurrency_levels": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "comparison_status": {
      "enum": [
        "single-host",
        "same-environment-only",
        "cross-host-no-shared-concurrency",
        "cross-host-comparable"
      ]
    },
    "cross_host_comparison_ready": {"type": "boolean"},
    "claim_semantics": {"const": "per-host-tested-envelopes-only"},
    "cross_host_aggregation": {"const": "not-performed"},
    "budget_status": {"const": "not-established"},
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/host"}
    }
  },
  "$defs": {
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_version",
        "platform_commit",
        "deployment_profile",
        "persistence_profile",
        "workload_distribution",
        "operation_count_per_point",
        "warmup_operations",
        "timeout_seconds"
      ],
      "properties": {
        "platform_version": {"type": "string", "minLength": 1},
        "platform_commit": {"type": "string", "minLength": 1},
        "deployment_profile": {"type": "string", "minLength": 1},
        "persistence_profile": {"type": "string", "minLength": 1},
        "workload_distribution": {"type": "string", "minLength": 1},
        "operation_count_per_point": {"type": "integer", "minimum": 1},
        "warmup_operations": {"type": "integer", "minimum": 0},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "source",
        "source_sha256",
        "environment_fingerprint_sha256",
        "environment",
        "concurrency_levels",
        "highest_verified_concurrency",
        "longest_verified_endurance_seconds",
        "concurrency_envelope"
      ],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "environment_fingerprint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment": {"type": "object"},
        "concurrency_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "highest_verified_concurrency": {"type": "integer", "minimum": 1},
        "longest_verified_endurance_seconds": {"type": "number", "minimum": 0},
        "concurrency_envelope": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/concurrency_point"}
        }
      }
    },
    "concurrency_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concurrency",
        "sample_count",
        "throughput_min_operations_per_second",
        "throughput_median_operations_per_second",
        "throughput_max_operations_per_second",
        "p95_latency_min_ms",
        "p95_latency_median_ms",
        "p95_latency_max_ms",
        "duration_median_seconds",
        "completed_operations_min",
        "storage_growth_median_bytes",
        "correctness_passed"
      ],
      "properties": {
        "concurrency": {"type": "integer", "minimum": 1},
        "sample_count": {"type": "integer", "minimum": 1},
        "throughput_min_operations_per_second": {"type": "number", "minimum": 0},
        "throughput_median_operations_per_second": {"type": "number", "minimum": 0},
        "throughput_max_operations_per_second": {"type": "number", "minimum": 0},
        "p95_latency_min_ms": {"type": "number", "minimum": 0},
        "p95_latency_median_ms": {"type": "number", "minimum": 0},
        "p95_latency_max_ms": {"type": "number", "minimum": 0},
        "duration_median_seconds": {"type": "number", "minimum": 0},
        "completed_operations_min": {"type": "integer", "minimum": 0},
        "storage_growth_median_bytes": {"type": "number"},
        "correctness_passed": {"const": true}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoresymphony.github.io/ai-multi-agent-platform/schemas/benchmark-persistence-sweep.v1.schema.json",
  "title": "AI Multi-Agent Platform Persistence Growing-State Sweep v1",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_version",
    "platform_version",
    "platform_commit",
    "started_at",
    "deployment_profile",
    "persistence_profile",
    "workload_distribution",
    "operation_count_per_point",
    "concurrency",
    "warmup_operations",
    "timeout_seconds",
    "repetitions",
    "seed_task_levels",
    "environment",
    "points",
    "correctness_passed",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark_id": {"const": "single-node.persistence.growing-state.sweep"},
    "benchmark_version": {"const": "1.0"},
    "platform_version": {"type": "string"},
    "platform_commit": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "deployment_profile": {"const": "single-node-reference"},
    "persistence_profile": {"type": "string", "minLength": 1},
    "workload_distribution": {"type": "string", "minLength": 1},
    "operation_count_per_point": {"type": "integer", "minimum": 1},
    "concurrency": {"type": "integer", "minimum": 1},
    "warmup_operations": {"type": "integer", "minimum": 0},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "repetitions": {"type": "integer", "minimum": 1},
    "seed_task_levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "environment": {"type": "object"},
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "seed_tasks",
          "repetition",
          "report_file",
          "throughput_operations_per_second",
          "read_p50_latency_ms",
          "read_p95_latency_ms",
          "read_p99_latency_ms",
          "restart_p50_latency_ms",
          "duration_seconds",
          "storage_bytes_after",
          "storage_bytes_per_seeded_task",
          "observed_tasks",
          "observed_runs",
          "correctness_passed"
        ],
        "properties": {
          "seed_tasks": {"type": "integer", "minimum": 1},
          "repetition": {"type": "integer", "minimum": 1},
          "report_file": {"type": "string", "minLength": 1},
          "throughput_operations_per_second": {"type": "number", "minimum": 0},
          "read_p50_latency_ms": {"type": "number", "minimum": 0},
          "read_p95_latency_ms": {"type": "number", "minimum": 0},
          "read_p99_latency_ms": {"type": "number", "minimum": 0},
          "restart_p50_latency_ms": {"type": "number", "minimum": 0},
          "duration_seconds": {"type": "number", "minimum": 0},
          "storage_bytes_after": {"type": "integer", "minimum": 0},
          "storage_bytes_per_seeded_task": {"type": "number", "minimum": 0},
          "observed_tasks": {"type": "integer", "minimum": 0},
          "observed_runs": {"type": "integer", "minimum": 0},
          "correctness_passed": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "correctness_passed": {"type": "boolean"},
    "errors": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}

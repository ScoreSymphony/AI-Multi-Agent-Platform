{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoresymphony.github.io/ai-multi-agent-platform/schemas/benchmark-report.v1.schema.json",
  "title": "AI Multi-Agent Platform Benchmark Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark",
    "platform_version",
    "platform_commit",
    "started_at",
    "duration_seconds",
    "environment",
    "throughput_operations_per_second",
    "operation_latency",
    "admission_latency",
    "execution_latency",
    "inspection_latency",
    "resources",
    "correctness",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark": {
      "type": "object",
      "required": [
        "benchmark_id",
        "benchmark_version",
        "deployment_profile",
        "operation_count",
        "concurrency",
        "warmup_operations",
        "timeout_seconds"
      ],
      "properties": {
        "benchmark_id": {"type": "string", "minLength": 1},
        "benchmark_version": {"type": "string", "minLength": 1},
        "deployment_profile": {"type": "string", "minLength": 1},
        "operation_count": {"type": "integer", "minimum": 1},
        "concurrency": {"type": "integer", "minimum": 1},
        "warmup_operations": {"type": "integer", "minimum": 0},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "platform_version": {"type": "string"},
    "platform_commit": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "environment": {
      "type": "object",
      "required": ["system", "python_implementation", "python_version", "python_major_minor"],
      "additionalProperties": true
    },
    "throughput_operations_per_second": {"type": "number", "minimum": 0},
    "operation_latency": {"$ref": "#/$defs/latency"},
    "admission_latency": {"$ref": "#/$defs/latency"},
    "execution_latency": {"$ref": "#/$defs/latency"},
    "inspection_latency": {"$ref": "#/$defs/latency"},
    "resources": {
      "type": "object",
      "required": [
        "process_cpu_seconds",
        "traced_memory_current_bytes",
        "traced_memory_peak_bytes",
        "peak_rss_bytes",
        "storage_bytes_before",
        "storage_bytes_after",
        "storage_growth_bytes",
        "open_file_descriptors"
      ],
      "properties": {
        "process_cpu_seconds": {"type": "number", "minimum": 0},
        "traced_memory_current_bytes": {"type": "integer", "minimum": 0},
        "traced_memory_peak_bytes": {"type": "integer", "minimum": 0},
        "peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
        "storage_bytes_before": {"type": "integer", "minimum": 0},
        "storage_bytes_after": {"type": "integer", "minimum": 0},
        "storage_growth_bytes": {"type": "integer"},
        "open_file_descriptors": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "correctness": {
      "type": "object",
      "required": [
        "attempted_operations",
        "completed_operations",
        "failed_operations",
        "duplicate_task_ids",
        "duplicate_run_ids",
        "timeline_failures",
        "passed"
      ],
      "properties": {
        "attempted_operations": {"type": "integer", "minimum": 0},
        "completed_operations": {"type": "integer", "minimum": 0},
        "failed_operations": {"type": "integer", "minimum": 0},
        "duplicate_task_ids": {"type": "integer", "minimum": 0},
        "duplicate_run_ids": {"type": "integer", "minimum": 0},
        "timeline_failures": {"type": "integer", "minimum": 0},
        "passed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "errors": {"type": "array", "items": {"type": "string"}},
    "baseline_comparison": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": [
            "comparable",
            "classification",
            "reasons",
            "p95_latency_change_ratio",
            "throughput_change_ratio"
          ],
          "properties": {
            "comparable": {"type": "boolean"},
            "classification": {
              "enum": ["incomparable", "comparable_no_budget", "pass", "regression"]
            },
            "reasons": {"type": "array", "items": {"type": "string"}},
            "p95_latency_change_ratio": {"type": ["number", "null"]},
            "throughput_change_ratio": {"type": ["number", "null"]}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$defs": {
    "latency": {
      "type": "object",
      "required": ["count", "min_ms", "mean_ms", "p50_ms", "p95_ms", "p99_ms", "max_ms"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "min_ms": {"type": "number", "minimum": 0},
        "mean_ms": {"type": "number", "minimum": 0},
        "p50_ms": {"type": "number", "minimum": 0},
        "p95_ms": {"type": "number", "minimum": 0},
        "p99_ms": {"type": "number", "minimum": 0},
        "max_ms": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoresymphony.github.io/ai-multi-agent-platform/schemas/benchmark-transport-fault.v1.schema.json",
  "title": "AI Multi-Agent Platform Transport Fault Benchmark Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark",
    "platform_version",
    "platform_commit",
    "started_at",
    "duration_seconds",
    "environment",
    "throughput_attempts_per_second",
    "publish_latency",
    "delivery_latency",
    "recovery_latency",
    "resources",
    "correctness",
    "error_counts",
    "measurements",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark": {
      "type": "object",
      "required": [
        "benchmark_id",
        "benchmark_version",
        "scenario",
        "transport_profile",
        "batch_size",
        "concurrency",
        "max_queue_size",
        "fault_operations",
        "timeout_seconds",
        "expected_invariants",
        "captured_metrics"
      ],
      "properties": {
        "benchmark_id": {"type": "string", "minLength": 1},
        "benchmark_version": {"type": "string", "minLength": 1},
        "scenario": {"enum": ["backpressure", "outage", "duplicate-delivery"]},
        "transport_profile": {"const": "in-process-reference"},
        "batch_size": {"type": "integer", "minimum": 1},
        "concurrency": {"type": "integer", "minimum": 1},
        "max_queue_size": {"type": "integer", "minimum": 1},
        "fault_operations": {"type": "integer", "minimum": 0},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "expected_invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "captured_metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "platform_version": {"type": "string"},
    "platform_commit": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "environment": {"type": "object"},
    "throughput_attempts_per_second": {"type": "number", "minimum": 0},
    "publish_latency": {"$ref": "#/$defs/latency"},
    "delivery_latency": {"$ref": "#/$defs/latency"},
    "recovery_latency": {"$ref": "#/$defs/latency"},
    "resources": {
      "type": "object",
      "required": [
        "process_cpu_seconds",
        "traced_memory_current_bytes",
        "traced_memory_peak_bytes",
        "peak_rss_bytes",
        "open_file_descriptors"
      ],
      "properties": {
        "process_cpu_seconds": {"type": "number", "minimum": 0},
        "traced_memory_current_bytes": {"type": "integer", "minimum": 0},
        "traced_memory_peak_bytes": {"type": "integer", "minimum": 0},
        "peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
        "open_file_descriptors": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "correctness": {
      "type": "object",
      "required": [
        "attempted_publishes",
        "accepted_publishes",
        "expected_failures",
        "unexpected_failures",
        "delivery_attempts",
        "unique_delivered_message_ids",
        "handler_executions",
        "suppressed_duplicate_handlers",
        "redelivered_deliveries",
        "expected_duplicate_delivery_attempts",
        "observed_duplicate_delivery_attempts",
        "message_loss_count",
        "recovered",
        "passed"
      ],
      "properties": {
        "attempted_publishes": {"type": "integer", "minimum": 0},
        "accepted_publishes": {"type": "integer", "minimum": 0},
        "expected_failures": {"type": "integer", "minimum": 0},
        "unexpected_failures": {"type": "integer", "minimum": 0},
        "delivery_attempts": {"type": "integer", "minimum": 0},
        "unique_delivered_message_ids": {"type": "integer", "minimum": 0},
        "handler_executions": {"type": "integer", "minimum": 0},
        "suppressed_duplicate_handlers": {"type": "integer", "minimum": 0},
        "redelivered_deliveries": {"type": "integer", "minimum": 0},
        "expected_duplicate_delivery_attempts": {"type": "integer", "minimum": 0},
        "observed_duplicate_delivery_attempts": {"type": "integer", "minimum": 0},
        "message_loss_count": {"type": "integer", "minimum": 0},
        "recovered": {"type": "boolean"},
        "passed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "error_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "measurements": {
      "type": "object",
      "additionalProperties": {"type": ["integer", "number", "string", "boolean", "null"]}
    },
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "latency": {
      "type": "object",
      "required": ["count", "min_ms", "mean_ms", "p50_ms", "p95_ms", "p99_ms", "max_ms"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "min_ms": {"type": "number", "minimum": 0},
        "mean_ms": {"type": "number", "minimum": 0},
        "p50_ms": {"type": "number", "minimum": 0},
        "p95_ms": {"type": "number", "minimum": 0},
        "p99_ms": {"type": "number", "minimum": 0},
        "max_ms": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

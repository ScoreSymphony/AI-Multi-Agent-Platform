{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoresymphony.github.io/ai-multi-agent-platform/schemas/benchmark-fault-under-load.v1.schema.json",
  "title": "AI Multi-Agent Platform Fault-Under-Load Benchmark Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark",
    "platform_version",
    "platform_commit",
    "started_at",
    "duration_seconds",
    "environment",
    "throughput_operations_per_second",
    "operation_latency",
    "read_latency",
    "write_latency",
    "restart_latency",
    "resources",
    "correctness",
    "measurements",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark": {
      "type": "object",
      "required": [
        "benchmark_id",
        "benchmark_version",
        "scenario",
        "deployment_profile",
        "persistence_profile",
        "operation_count",
        "concurrency",
        "fault_after_operations",
        "seed_tasks",
        "warmup_operations",
        "timeout_seconds",
        "safety_max_operations",
        "safety_max_concurrency",
        "read_weight",
        "write_weight",
        "optional_subsystems",
        "expected_invariants",
        "captured_metrics"
      ],
      "properties": {
        "benchmark_id": {"type": "string", "minLength": 1},
        "benchmark_version": {"type": "string", "minLength": 1},
        "scenario": {"const": "control-plane-restart"},
        "deployment_profile": {"const": "single-node-reference"},
        "persistence_profile": {"type": "string", "minLength": 1},
        "operation_count": {"type": "integer", "minimum": 2},
        "concurrency": {"type": "integer", "minimum": 1},
        "fault_after_operations": {"type": "integer", "minimum": 1},
        "seed_tasks": {"type": "integer", "minimum": 1},
        "warmup_operations": {"type": "integer", "minimum": 0},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "safety_max_operations": {"type": "integer", "minimum": 2},
        "safety_max_concurrency": {"type": "integer", "minimum": 1},
        "read_weight": {"type": "integer", "minimum": 0},
        "write_weight": {"type": "integer", "minimum": 0},
        "optional_subsystems": {"type": "array", "items": {"type": "string"}},
        "expected_invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "captured_metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "platform_version": {"type": "string"},
    "platform_commit": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "environment": {"type": "object"},
    "throughput_operations_per_second": {"type": "number", "minimum": 0},
    "operation_latency": {"$ref": "#/$defs/latency"},
    "read_latency": {"$ref": "#/$defs/latency"},
    "write_latency": {"$ref": "#/$defs/latency"},
    "restart_latency": {"$ref": "#/$defs/latency"},
    "resources": {"$ref": "#/$defs/resources"},
    "correctness": {
      "type": "object",
      "required": [
        "attempted_operations",
        "completed_operations",
        "failed_operations",
        "pre_fault_completed_operations",
        "post_fault_completed_operations",
        "seeded_tasks",
        "observed_tasks",
        "observed_runs",
        "duplicate_write_task_ids",
        "duplicate_write_run_ids",
        "authentication_preserved",
        "unauthorized_access_blocked",
        "health_recovered",
        "readiness_recovered",
        "passed"
      ],
      "properties": {
        "attempted_operations": {"type": "integer", "minimum": 0},
        "completed_operations": {"type": "integer", "minimum": 0},
        "failed_operations": {"type": "integer", "minimum": 0},
        "pre_fault_completed_operations": {"type": "integer", "minimum": 0},
        "post_fault_completed_operations": {"type": "integer", "minimum": 0},
        "seeded_tasks": {"type": "integer", "minimum": 1},
        "observed_tasks": {"type": "integer", "minimum": 0},
        "observed_runs": {"type": "integer", "minimum": 0},
        "duplicate_write_task_ids": {"type": "integer", "minimum": 0},
        "duplicate_write_run_ids": {"type": "integer", "minimum": 0},
        "authentication_preserved": {"type": "boolean"},
        "unauthorized_access_blocked": {"type": "boolean"},
        "health_recovered": {"type": "boolean"},
        "readiness_recovered": {"type": "boolean"},
        "passed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "measurements": {
      "type": "object",
      "additionalProperties": {"type": ["integer", "number", "string", "boolean", "null"]}
    },
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "latency": {
      "type": "object",
      "required": ["count", "min_ms", "mean_ms", "p50_ms", "p95_ms", "p99_ms", "max_ms"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "min_ms": {"type": "number", "minimum": 0},
        "mean_ms": {"type": "number", "minimum": 0},
        "p50_ms": {"type": "number", "minimum": 0},
        "p95_ms": {"type": "number", "minimum": 0},
        "p99_ms": {"type": "number", "minimum": 0},
        "max_ms": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": [
        "process_cpu_seconds",
        "traced_memory_current_bytes",
        "traced_memory_peak_bytes",
        "peak_rss_bytes",
        "storage_bytes_before",
        "storage_bytes_after",
        "storage_growth_bytes",
        "open_file_descriptors"
      ],
      "properties": {
        "process_cpu_seconds": {"type": "number", "minimum": 0},
        "traced_memory_current_bytes": {"type": "integer", "minimum": 0},
        "traced_memory_peak_bytes": {"type": "integer", "minimum": 0},
        "peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
        "storage_bytes_before": {"type": "integer", "minimum": 0},
        "storage_bytes_after": {"type": "integer", "minimum": 0},
        "storage_growth_bytes": {"type": "integer"},
        "open_file_descriptors": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark-distributed-faults.v1.schema.json",
  "title": "Distributed Worker and Workspace Fault Benchmark Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark",
    "platform_version",
    "platform_commit",
    "started_at",
    "duration_seconds",
    "environment",
    "throughput_successful_jobs_per_second",
    "pre_fault_dispatch_latency",
    "worker_loss_reconciliation_latency",
    "degraded_dispatch_latency",
    "worker_rejoin_latency",
    "post_rejoin_dispatch_latency",
    "workspace_failure_latency",
    "workspace_recovery_dispatch_latency",
    "placement_counts",
    "resources",
    "correctness",
    "lost_worker_id",
    "worker_ids",
    "worker_job_ids",
    "run_ids",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_count",
        "pre_fault_rounds",
        "degraded_rounds",
        "post_rejoin_rounds",
        "payload_bytes",
        "heartbeat_timeout_seconds",
        "reservation_ttl_seconds",
        "timeout_seconds",
        "safety_max_operations",
        "safety_max_payload_bytes",
        "benchmark_id",
        "benchmark_version",
        "deployment_profile",
        "transport_profile",
        "pre_fault_jobs",
        "degraded_jobs",
        "post_rejoin_jobs",
        "expected_successful_jobs",
        "total_attempts",
        "expected_invariants",
        "captured_metrics"
      ],
      "properties": {
        "worker_count": {"type": "integer", "minimum": 2},
        "pre_fault_rounds": {"type": "integer", "minimum": 1},
        "degraded_rounds": {"type": "integer", "minimum": 1},
        "post_rejoin_rounds": {"type": "integer", "minimum": 1},
        "payload_bytes": {"type": "integer", "minimum": 1},
        "heartbeat_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "reservation_ttl_seconds": {"type": "number", "exclusiveMinimum": 0},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "safety_max_operations": {"type": "integer", "minimum": 1},
        "safety_max_payload_bytes": {"type": "integer", "minimum": 1},
        "benchmark_id": {"const": "distributed.worker-workspace.faults"},
        "benchmark_version": {"const": "1.0"},
        "deployment_profile": {"const": "distributed-reference-in-process-transport"},
        "transport_profile": {"const": "in-process-message-transport"},
        "pre_fault_jobs": {"type": "integer", "minimum": 1},
        "degraded_jobs": {"type": "integer", "minimum": 1},
        "post_rejoin_jobs": {"type": "integer", "minimum": 1},
        "expected_successful_jobs": {"type": "integer", "minimum": 1},
        "total_attempts": {"type": "integer", "minimum": 2},
        "expected_invariants": {"type": "array", "items": {"type": "string"}},
        "captured_metrics": {"type": "array", "items": {"type": "string"}}
      }
    },
    "platform_version": {"type": "string", "minLength": 1},
    "platform_commit": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "duration_seconds": {"type": "number", "minimum": 0},
    "environment": {"type": "object"},
    "throughput_successful_jobs_per_second": {"type": "number", "minimum": 0},
    "pre_fault_dispatch_latency": {"$ref": "#/$defs/latency"},
    "worker_loss_reconciliation_latency": {"$ref": "#/$defs/latency"},
    "degraded_dispatch_latency": {"$ref": "#/$defs/latency"},
    "worker_rejoin_latency": {"$ref": "#/$defs/latency"},
    "post_rejoin_dispatch_latency": {"$ref": "#/$defs/latency"},
    "workspace_failure_latency": {"$ref": "#/$defs/latency"},
    "workspace_recovery_dispatch_latency": {"$ref": "#/$defs/latency"},
    "placement_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "resources": {"$ref": "#/$defs/resources"},
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_workers",
        "stable_worker_ids",
        "lost_worker_offline",
        "degraded_jobs",
        "degraded_terminal_jobs",
        "degraded_avoided_lost_worker",
        "rejoined_worker_online",
        "rejoin_preserved_identity",
        "post_rejoin_jobs",
        "post_rejoin_terminal_jobs",
        "post_rejoin_used_rejoined_worker",
        "workspace_failure_observed",
        "workspace_failure_code",
        "workspace_failure_retryable",
        "workspace_failure_record_lost",
        "workspace_failure_reached_execution",
        "workspace_recovery_terminal",
        "workspace_cleanup_succeeded",
        "expected_successful_jobs",
        "terminal_successful_jobs",
        "duplicate_worker_job_ids",
        "duplicate_run_ids",
        "passed"
      ],
      "properties": {
        "expected_workers": {"type": "integer", "minimum": 2},
        "stable_worker_ids": {"type": "integer", "minimum": 0},
        "lost_worker_offline": {"type": "boolean"},
        "degraded_jobs": {"type": "integer", "minimum": 1},
        "degraded_terminal_jobs": {"type": "integer", "minimum": 0},
        "degraded_avoided_lost_worker": {"type": "boolean"},
        "rejoined_worker_online": {"type": "boolean"},
        "rejoin_preserved_identity": {"type": "boolean"},
        "post_rejoin_jobs": {"type": "integer", "minimum": 1},
        "post_rejoin_terminal_jobs": {"type": "integer", "minimum": 0},
        "post_rejoin_used_rejoined_worker": {"type": "boolean"},
        "workspace_failure_observed": {"type": "boolean"},
        "workspace_failure_code": {"type": ["string", "null"]},
        "workspace_failure_retryable": {"type": "boolean"},
        "workspace_failure_record_lost": {"type": "boolean"},
        "workspace_failure_reached_execution": {"type": "boolean"},
        "workspace_recovery_terminal": {"type": "boolean"},
        "workspace_cleanup_succeeded": {"type": "boolean"},
        "expected_successful_jobs": {"type": "integer", "minimum": 1},
        "terminal_successful_jobs": {"type": "integer", "minimum": 0},
        "duplicate_worker_job_ids": {"type": "integer", "minimum": 0},
        "duplicate_run_ids": {"type": "integer", "minimum": 0},
        "passed": {"type": "boolean"}
      }
    },
    "lost_worker_id": {"type": "string", "minLength": 1},
    "worker_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "worker_job_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "min_ms", "mean_ms", "p50_ms", "p95_ms", "p99_ms", "max_ms"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "min_ms": {"type": "number", "minimum": 0},
        "mean_ms": {"type": "number", "minimum": 0},
        "p50_ms": {"type": "number", "minimum": 0},
        "p95_ms": {"type": "number", "minimum": 0},
        "p99_ms": {"type": "number", "minimum": 0},
        "max_ms": {"type": "number", "minimum": 0}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_cpu_seconds",
        "traced_memory_current_bytes",
        "traced_memory_peak_bytes",
        "peak_rss_bytes",
        "storage_bytes_before",
        "storage_bytes_after",
        "storage_growth_bytes",
        "open_file_descriptors"
      ],
      "properties": {
        "process_cpu_seconds": {"type": "number", "minimum": 0},
        "traced_memory_current_bytes": {"type": "integer", "minimum": 0},
        "traced_memory_peak_bytes": {"type": "integer", "minimum": 0},
        "peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
        "storage_bytes_before": {"type": "integer", "minimum": 0},
        "storage_bytes_after": {"type": "integer", "minimum": 0},
        "storage_growth_bytes": {"type": "integer"},
        "open_file_descriptors": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}

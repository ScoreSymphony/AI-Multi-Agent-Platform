{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoresymphony.dev/schemas/benchmark-api-pressure.v1.schema.json",
  "title": "API Pressure Benchmark Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark",
    "platform_version",
    "platform_commit",
    "started_at",
    "duration_seconds",
    "environment",
    "throughput_operations_per_second",
    "operation_latency",
    "bearer_list_latency",
    "session_list_latency",
    "authorized_detail_latency",
    "pagination_scan_latency",
    "pagination_page_latency",
    "resources",
    "correctness",
    "measurements",
    "sample_task_ids",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark": {"$ref": "#/$defs/benchmark"},
    "platform_version": {"type": "string", "minLength": 1},
    "platform_commit": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "duration_seconds": {"type": "number", "minimum": 0},
    "environment": {"type": "object"},
    "throughput_operations_per_second": {"type": "number", "minimum": 0},
    "operation_latency": {"$ref": "#/$defs/latency"},
    "bearer_list_latency": {"$ref": "#/$defs/latency"},
    "session_list_latency": {"$ref": "#/$defs/latency"},
    "authorized_detail_latency": {"$ref": "#/$defs/latency"},
    "pagination_scan_latency": {"$ref": "#/$defs/latency"},
    "pagination_page_latency": {"$ref": "#/$defs/latency"},
    "resources": {"$ref": "#/$defs/resources"},
    "correctness": {"$ref": "#/$defs/correctness"},
    "measurements": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    },
    "sample_task_ids": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_tasks",
        "operation_count",
        "concurrency",
        "page_size",
        "warmup_operations",
        "timeout_seconds",
        "safety_max_seed_tasks",
        "repetition_count",
        "benchmark_id",
        "benchmark_version",
        "deployment_profile",
        "persistence_profile",
        "workload_distribution",
        "expected_pages_per_scan",
        "expected_invariants",
        "captured_metrics"
      ],
      "properties": {
        "seed_tasks": {"type": "integer", "minimum": 1},
        "operation_count": {"type": "integer", "minimum": 4},
        "concurrency": {"type": "integer", "minimum": 1},
        "page_size": {"type": "integer", "minimum": 1, "maximum": 200},
        "warmup_operations": {"type": "integer", "minimum": 0},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "safety_max_seed_tasks": {"type": "integer", "minimum": 1},
        "repetition_count": {"const": 1},
        "benchmark_id": {"const": "single-node.api-pressure"},
        "benchmark_version": {"const": "1.0"},
        "deployment_profile": {"const": "single-node-reference"},
        "persistence_profile": {"const": "sqlite-reference"},
        "workload_distribution": {"const": "bearer-session-detail-pagination"},
        "expected_pages_per_scan": {"type": "integer", "minimum": 1},
        "expected_invariants": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "captured_metrics": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "min_ms", "mean_ms", "p50_ms", "p95_ms", "p99_ms", "max_ms"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "min_ms": {"type": "number", "minimum": 0},
        "mean_ms": {"type": "number", "minimum": 0},
        "p50_ms": {"type": "number", "minimum": 0},
        "p95_ms": {"type": "number", "minimum": 0},
        "p99_ms": {"type": "number", "minimum": 0},
        "max_ms": {"type": "number", "minimum": 0}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_cpu_seconds",
        "traced_memory_current_bytes",
        "traced_memory_peak_bytes",
        "peak_rss_bytes",
        "storage_bytes_before",
        "storage_bytes_after",
        "storage_growth_bytes",
        "open_file_descriptors"
      ],
      "properties": {
        "process_cpu_seconds": {"type": "number", "minimum": 0},
        "traced_memory_current_bytes": {"type": "integer", "minimum": 0},
        "traced_memory_peak_bytes": {"type": "integer", "minimum": 0},
        "peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
        "storage_bytes_before": {"type": "integer", "minimum": 0},
        "storage_bytes_after": {"type": "integer", "minimum": 0},
        "storage_growth_bytes": {"type": "integer"},
        "open_file_descriptors": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted_operations",
        "completed_operations",
        "failed_operations",
        "seeded_tasks",
        "observed_tasks",
        "bearer_list_operations",
        "session_list_operations",
        "authorized_detail_operations",
        "pagination_scan_operations",
        "pagination_page_requests",
        "pagination_duplicate_ids",
        "pagination_incomplete_scans",
        "measured_http_requests",
        "unique_request_ids",
        "passed"
      ],
      "properties": {
        "attempted_operations": {"type": "integer", "minimum": 4},
        "completed_operations": {"type": "integer", "minimum": 0},
        "failed_operations": {"type": "integer", "minimum": 0},
        "seeded_tasks": {"type": "integer", "minimum": 1},
        "observed_tasks": {"type": "integer", "minimum": 0},
        "bearer_list_operations": {"type": "integer", "minimum": 0},
        "session_list_operations": {"type": "integer", "minimum": 0},
        "authorized_detail_operations": {"type": "integer", "minimum": 0},
        "pagination_scan_operations": {"type": "integer", "minimum": 0},
        "pagination_page_requests": {"type": "integer", "minimum": 0},
        "pagination_duplicate_ids": {"type": "integer", "minimum": 0},
        "pagination_incomplete_scans": {"type": "integer", "minimum": 0},
        "measured_http_requests": {"type": "integer", "minimum": 0},
        "unique_request_ids": {"type": "integer", "minimum": 0},
        "passed": {"type": "boolean"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoresymphony.github.io/ai-multi-agent-platform/schemas/benchmark-reference-host-absolute-budget-report.v1.schema.json",
  "title": "AI Multi-Agent Platform Reference Host Absolute Budget Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_version",
    "generated_at",
    "claim_semantics",
    "platform_budget_status",
    "budget_scope",
    "policy",
    "evidence",
    "basis",
    "overall_classification",
    "rules",
    "correctness_passed"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark_id": {"const": "single-node.reference.host-campaign.absolute-budget"},
    "benchmark_version": {"const": "1.0"},
    "generated_at": {"type": "string", "minLength": 1},
    "claim_semantics": {"const": "evidence-scoped-absolute-budget-policy-only"},
    "platform_budget_status": {"const": "not-established"},
    "budget_scope": {"const": "reference-environment-only"},
    "policy": {
      "type": "object",
      "required": [
        "source",
        "sha256",
        "policy_id",
        "policy_version",
        "justification",
        "evidence_refs",
        "minimum_campaign_count"
      ],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "policy_id": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "justification": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "minimum_campaign_count": {"type": "integer", "minimum": 2}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["source", "sha256", "platform_version", "platform_commit", "campaign_count"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "platform_version": {"type": "string", "minLength": 1},
        "platform_commit": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
        "campaign_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "basis": {
      "type": "object",
      "required": [
        "host_label",
        "profile",
        "configuration_sha256",
        "environment_fingerprint_sha256",
        "deployment_profile",
        "persistence_profile",
        "workload_distribution"
      ],
      "properties": {
        "host_label": {"type": "string", "minLength": 1},
        "profile": {"const": "release"},
        "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "environment_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "deployment_profile": {"type": "string", "minLength": 1},
        "persistence_profile": {"type": "string", "minLength": 1},
        "workload_distribution": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "overall_classification": {"enum": ["pass", "warning", "release-blocking"]},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "scope",
          "metric",
          "concurrency",
          "direction",
          "observed_median",
          "sample_count",
          "warning_boundary",
          "release_blocking_boundary",
          "classification",
          "evidence_refs"
        ],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "scope": {"enum": ["concurrency", "endurance"]},
          "metric": {
            "enum": [
              "throughput_operations_per_second",
              "p95_latency_ms",
              "storage_growth_bytes",
              "traced_memory_growth_bytes",
              "peak_rss_growth_bytes",
              "open_file_descriptor_growth",
              "latency_drift_ratio"
            ]
          },
          "concurrency": {"type": ["integer", "null"], "minimum": 1},
          "direction": {"enum": ["higher-is-better", "lower-is-better"]},
          "observed_median": {"type": "number"},
          "sample_count": {"type": "integer", "minimum": 1},
          "warning_boundary": {"type": "number"},
          "release_blocking_boundary": {"type": "number"},
          "classification": {"enum": ["pass", "warning", "release-blocking"]},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "correctness_passed": {"const": true}
  },
  "additionalProperties": false
}
